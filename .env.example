# EdgeScout — runtime configuration (all optional for the testnet demo).
# Copy to .env (never committed) and fill in what you have.

# --- LLM (any OpenAI-compatible endpoint: OpenAI / DeepSeek / local sglang / ...) ---
# Live mode activates when LLM_API_KEY is non-empty OR LLM_BASE_URL is set to
# something other than the default — so a keyless self-hosted endpoint works:
# just point LLM_BASE_URL at it (Authorization is then omitted). With neither,
# the agent runs in mock mode: a deterministic template report with the same
# numbers, so the demo still works end-to-end.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Reasoning models spend output on chain-of-thought first; 1500 leaves room
# for the JSON schema on top. Timeout matters for cold GPUs: 60s default.
#LLM_MAX_TOKENS=1500
#LLM_TIMEOUT_MS=60000
# Optional raw-JSON fragment merged into the chat/completions request body.
# For Qwen3-style models this defaults to {"chat_template_kwargs":{"enable_thinking":false}}
# (auto-detected for models whose name contains "qwen"); set explicitly to
# override or to apply to non-qwen model names.
#LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# --- DreamDEX event-contract venue (Somnia testnet) ---
# Testnet venue id has moved before; when the board comes back empty the
# server re-derives the venue from live market rows, so this is a fallback.
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# --- Board / paper trading ----------------------------------------------------
# How many markets the wall renders (each row costs one order-book fetch).
BOARD_SIZE=24

# --- Attestcoin Protocol (Creditcoin CC3 testnet, read-only) -------------------
# /api/attest proves a source-chain (Sepolia) transaction on Creditcoin: it
# fetches a Merkle + continuity proof from the hosted proof builder and verifies
# it with a free eth_call against the Block Prover precompile (0x0FD2). No
# wallet, no private key, no gas — every value below is public testnet data and
# all four have working defaults.
# Creditcoin CC3 testnet JSON-RPC (EVM chain id 102031) — the chain that verifies.
CC3_TESTNET_RPC=https://rpc.cc3-testnet.creditcoin.network
# Hosted proof-builder service (free HTTP, no key).
ATTEST_PROVER_URL=https://prover.cc3-testnet.creditcoin.network
# Source chain to read FROM: 1 = Ethereum Sepolia on CC3 testnet, 3 = Ethereum
# Mainnet. Somnia is not an attested source chain, so the attested signal has to
# originate on Sepolia.
ATTEST_CHAIN_KEY=1
# Transaction to attest by default (the official tutorial burn tx on Sepolia,
# block 8,812,893). Override per request with /api/attest?txHash=0x...
ATTEST_DEFAULT_TX_HASH=0xbc1aefc42f7bc5897e7693e815831729dc401877df182b137ab3bf06edeaf0e1

# --- EdgeScout ASC on-chain ledger (Creditcoin CC3 testnet, read-only) --------
# EdgeScoutSignalStore (contracts/src/EdgeScoutSignalStore.sol) is EdgeScout's own
# Attestcoin Smart Contract: it re-verifies a proof through the Block Prover
# precompile inside the transaction and stores the decoded fact permanently.
# /api/asc reads that state with eth_call only — still no wallet and no gas; the
# single write path lives in scripts/attest-on-asc.mjs, outside the app.
#
# LEAVE THIS EMPTY until the ASC is deployed. Empty is a supported state: the
# route answers {"ok":true,"deployed":false} with a note and the dashboard shows
# "not deployed yet (testnet funds pending)". Fill it in with the address printed
# by `node scripts/deploy-asc.mjs`.
EDGE_SCOUT_ASC_ADDRESS=
# EvmV1Decoder library address, only when the ASC links against a deployed one.
# With @gluwa/usc-contracts@0.2.0 the decoder exposes internal functions only, so
# solc inlines it and no library is deployed — leave this empty.
EVMV1_DECODER_LIB_ADDRESS=
# Blockscout base URL used to build explorer links (has a working default).
#CC3_EXPLORER_URL=https://creditcoin-testnet.blockscout.com

# --- KeeperHub (Agent Economy execution, Base Sepolia testnet) ---------------
# /api/keeperhub + the dashboard "execute on-chain" flow: EdgeScout sizes a
# testnet USDC transfer from its 1/4-Kelly signal; KeeperHub executes it from
# the org wallet; the tx link is written back into the paper ledger entry.
# LEAVE THIS EMPTY until you have an org API key from app.keeperhub.com
# (starts with kh_). Empty is a supported state: the API answers
# {"configured":false} with a note and the dashboard shows "NOT CONFIGURED".
# NEVER commit a real key - it can move the org's funds.
KEEPERHUB_API_KEY=
#KEEPERHUB_API_BASE=https://app.keeperhub.com
#KEEPERHUB_CHAIN=base-sepolia
#KEEPERHUB_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
#KEEPERHUB_MAX_STAKE_USD=25
# When "true", every execution is a KeeperHub simulate preflight (no tx).
#KEEPERHUB_DRY_RUN=false
